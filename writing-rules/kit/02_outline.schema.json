{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "outline.json（§3.3）",
  "type": "object",
  "required": ["book", "chapters", "paths"],
  "properties": {
    "book": {
      "type": "object",
      "required": ["title", "type", "claim", "target_words", "family"],
      "properties": {
        "title": {"type": "string", "minLength": 2},
        "type": {"enum": ["原理书", "实战书", "案例书", "排错书", "工具书", "演进书", "通识书"]},
        "claim": {"type": "string", "minLength": 10},
        "target_words": {"type": "integer", "minimum": 30000},
        "family": {"enum": ["A", "B", "C", "mixed"]},
        "review_by": {"type": "string", "pattern": "^\\d{4}-\\d{2}$"}
      }
    },
    "volumes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "purpose", "chapters"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "purpose": {"type": "string", "minLength": 4},
          "chapters": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "purpose", "produces", "role", "sections"],
        "properties": {
          "id": {"type": "string", "pattern": "^C\\d{2}$"},
          "title": {"type": "string"},
          "purpose": {"type": "string", "minLength": 4},
          "produces": {"type": "string", "minLength": 2},
          "role": {
            "type": "object",
            "required": ["phenomenon", "mechanism", "cost"],
            "properties": {
              "phenomenon": {"type": "string"},
              "mechanism": {"type": "string"},
              "cost": {"type": "string"}
            }
          },
          "requires": {"type": "array", "items": {"type": "string"}},
          "words": {"type": "integer"},
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "title", "question", "produces", "bridge", "layer", "deps", "status"],
              "properties": {
                "id": {"type": "string", "pattern": "^C\\d{2}-S\\d{1,2}$"},
                "title": {"type": "string"},
                "question": {"type": "string", "minLength": 4},
                "produces": {"type": "string", "minLength": 2},
                "bridge": {"type": "string", "minLength": 2},
                "layer": {"enum": ["现象", "机制", "代价"]},
                "concepts": {"type": "array", "items": {"type": "string"}},
                "deps": {"type": "array", "items": {"type": "string"}},
                "words": {"type": "integer"},
                "status": {"enum": ["planned", "drafting", "checking", "frozen"]}
              }
            }
          }
        }
      }
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "order"],
        "properties": {
          "name": {"type": "string"},
          "order": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "concepts": {"type": "array"}
  }
}
