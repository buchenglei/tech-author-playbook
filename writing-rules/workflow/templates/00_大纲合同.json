{
  "_说明": "大纲合同：从用户写作大纲提炼的硬约束。与 writing-rules 与规范不一致时 → 融合评估人确认（见 09_大纲×规范融合评估.md）。生成后勿手改成更松。",
  "_口径钉死": "word_count_metric / evidence_policy / chapter_blocks_as_headings 三项必须在 P1 阶段钉死并经人确认（09 融合评估签字）。不钉死会出现同一稿子两种薄厚结论（F# 案例）与「固定块写成挂牌小节是否算违规」的悬案（Avalonia 案例）。chapter_blocks_as_headings=true 表示合同固定块允许用小节标题承载（检查点式）；false 表示必须行文承载；不声明却用标题 = QG-06。",
  "outline_file": "",
  "priority_rule": "writing-rules MUST 为基线；大纲要求融合为项目特化层，经 09 融合评估人确认后写入宪法，形成该书统一规则",

  "word_count_metric": "cjk_len",
  "evidence_policy": "body-e-tags",
  "chapter_blocks_as_headings": false,
  "evidence_markers": ["无法验证（未实测）", "本机实测", "官方", "推断", "未实测"],
  "deliverables": [],
  "figures_min": 0,
  "chapter_blocks_aliases": {},
  "decay_thresholds": {
    "length_drop_ratio": 0.55,
    "defect_growth": 2.0,
    "spec_cov_drop": 0.3
  },

  "pages": {
    "target_min": 230,
    "target_max": 250,
    "chars_per_page": 450,
    "derived_chars_min": 103500,
    "derived_chars_max": 112500,
    "note": "页数来自大纲；换算仅作门禁下限参考"
  },

  "book": {
    "target_words_min": 100000,
    "target_words_max": 130000,
    "structure_min_chapters": 20
  },

  "section": {
    "words_min_ratio": 0.6,
    "words_absolute_min": 1200,
    "note": "冻结前实写字数 ≥ max(0.6*预算, 绝对下限)；禁止以省 token 为由写梗概"
  },

  "chapter_blocks_required": [
    "目标",
    "痛点开场",
    "正文",
    "标尺",
    "落地_命令与预期输出",
    "避坑",
    "小结_官方锚点"
  ],
  "chapter_blocks_exempt": ["附录"],

  "quality": {
    "forbid_min_token_on_body": true,
    "forbid_outline_as_body": true,
    "prefer_depth_over_breadth": true
  },

  "process": {
    "phase1_must_human": true,
    "phase1_rule_conflict_report": true,
    "review_every_n_chapters": 3
  }
}
